# Choose: gemini or groq
LLM_PROVIDER=gemini
LLM_API_KEY=
# Optional. Defaults are supplied in app/config.py; set a currently available model explicitly if needed.
LLM_MODEL=
DATABASE_PATH=data/pharma.db
MAX_QUERY_ROWS=200
QUERY_TIMEOUT_SECONDS=3
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_OUTPUT_TOKENS=500
ALLOWED_ORIGINS=http://localhost:5173
